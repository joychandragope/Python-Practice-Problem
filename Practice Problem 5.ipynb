   "source": [
    "### Given a list [1,2,3,4,5,6], use filter() to select even numbers and map() with lambda to square them."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "1715e709-2f99-4289-aa7b-b0ea51f7fd9d",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[4, 16, 36]\n"
     ]
    }
   ],
   "source": [
    "data_list = [1, 2, 3, 4, 5, 6]\n",
    "new_list = list(map(lambda x: x*x, data_list))\n",
    "new_filter_list = list(filter(lambda x: x%2==0,new_list))\n",
    "#print(new_list)\n",
    "print(new_filter_list)"
   ]
  }
 ],
